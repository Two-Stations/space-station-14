<DefaultWindow xmlns="https://spacestation14.io"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            x:Class="Content.Client.Administration.UI.Tabs.AdminTab.AdminShuttleWindow"
            Title="{Loc 'admin-shuttle-title'}"
            MinSize="500 200">
    <BoxContainer Name="MasterContainer" Orientation="Vertical" VerticalExpand="True">
        <Button Name="RefreshButton"
                Text="{Loc 'admin-shuttle-refresh-button'}"
                MinWidth="100"
                HorizontalAlignment="Right"
                Margin="0 0 5 5"/>
        <ScrollContainer VerticalExpand="True">
            <BoxContainer Name="StationContainer"
                          Orientation="Vertical"
                          HorizontalExpand="True"
                          VerticalExpand="True"/>
        </ScrollContainer>
    </BoxContainer>
</DefaultWindow>
